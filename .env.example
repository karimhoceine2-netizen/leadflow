# Local showcase defaults. No production keys or credentials are needed.
APP_ENV=development
STORAGE_MODE=demo
DEMO_DB_PATH=backend/data/leadflow.sqlite3
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTOMATION_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional adapters; fill only in your own ignored .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/magnifize-leadflow
N8N_WEBHOOK_SECRET=
